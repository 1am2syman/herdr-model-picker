{
  "name": "herdr-model-picker",
  "version": "0.1.0",
  "description": "Prepare exact Pi launches in Herdr from the prompt editor",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md",
    "VERIFICATION.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "verify": "npm run check && npm test && node -e \"console.log('verification passed')\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1am2syman/herdr-model-picker.git"
  },
  "homepage": "https://github.com/1am2syman/herdr-model-picker#readme",
  "bugs": {
    "url": "https://github.com/1am2syman/herdr-model-picker/issues"
  }
}
